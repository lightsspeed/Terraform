# ==============================================================================
# Terraform .gitignore — Day5
# Excludes provider binaries, state files, and sensitive values from git.
# ==============================================================================

# Provider binaries (re-downloaded via "terraform init")
.terraform/

# State files — may contain sensitive resource data
terraform.tfstate
terraform.tfstate.backup

# Local variable overrides (may contain secrets)
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Plan output files
*.tfplan
