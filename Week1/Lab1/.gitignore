# ==============================================================================
# Terraform .gitignore
# Excludes files that should NEVER be committed to version control:
#   - Provider binaries (hundreds of MB, downloaded by "terraform init")
#   - State files (may contain sensitive resource data / secrets)
#   - Local override files (machine-specific settings)
#   - Crash/debug logs
# ==============================================================================

# Terraform provider binaries and init cache — re-downloaded by "terraform init"
.terraform/

# Lock file is safe to commit (pins provider versions), but exclude if preferred
# .terraform.lock.hcl

# State files — contain real infrastructure state and may include sensitive values.
# Use a remote backend (S3 + DynamoDB) to store state securely instead.
terraform.tfstate
terraform.tfstate.backup

# Local variable overrides — typically contain secrets or personal values
*.tfvars
*.tfvars.json

# Crash log output generated by Terraform on panic
crash.log
crash.*.log

# Generated plan files — binary, not human-readable, re-run "terraform plan" instead
*.tfplan
