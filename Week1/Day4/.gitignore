# Local .terraform directory
.terraform/
.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*

# Backup state files
*.backup
*backup*

# Crash logs
crash.log
crash.*.log

# tfvars files with secrets (never commit real secrets!)
# Keep template/example files, but ignore real ones
*.tfvars
!*.tfvars.example     # Allow example files if you have them

# Ignore override files (used for local testing)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan output files
*.plan
*.tfplan

# Ignore output files you create manually
outputs.txt

# Keys folder – NEVER commit SSH/RSA keys
keys/
*.pem
*.key
*.pub

# Ignore any local scripts or data
data.tf      # If you have local data files you don't want tracked
.gitignore~  # Editor backups

# macOS junk
.DS_Store

# VS Code settings (optional – ignore if personal)
.vscode/